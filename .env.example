# Copy to .env.local for local development. All values are optional in development.

# Leave empty to use the embedded PGlite database stored in PGLITE_DIR (no server needed).
# Set to a postgres:// URL to use a real PostgreSQL server (run `npm run db:migrate` first).
DATABASE_URL=
PGLITE_DIR=.data/pglite

# Required in production: at least 32 random characters. Generate with `openssl rand -base64 48`.
AUTH_SECRET=

APP_URL=http://localhost:3000

# console: sign-in codes are printed in the server log.
# file: sign-in codes are appended to MAILBOX_FILE (used by end-to-end tests).
EMAIL_TRANSPORT=console
MAILBOX_FILE=.data/mailbox.log
