diff --git a/tests/cli/build/build-kicad-project-design-rules.test.ts b/tests/cli/build/build-kicad-project-design-rules.test.ts
new file mode 100644
index 0000000..3ed8e37
--- /dev/null
+++ b/tests/cli/build/build-kicad-project-design-rules.test.ts
@@ -0,0 +1,54 @@
+import { test, expect } from "bun:test"
+import { createKicadProContent } from "../../../cli/build/generate-kicad-project"
+
+test("kicad_pro preserves <board /> design rules (issue #4716)", () => {
+  const circuitJson: any[] = [
+    {
+      type: "pcb_board",
+      pcb_board_id: "pcb_board_0",
+      center: { x: 0, y: 0 },
+      width: 20,
+      height: 20,
+      thickness: 1.6,
+      num_layers: 2,
+      material: "fr4",
+      min_trace_width: 0.15,
+      min_board_edge_clearance: 0.3,
+    },
+  ]
+
+  const pro = JSON.parse(
+    createKicadProContent({
+      circuitJson,
+      projectName: "rules",
+      schematicFileName: "rules.kicad_sch",
+      boardFileName: "rules.kicad_pcb",
+    }),
+  )
+
+  const rules = pro.board.design_settings.rules
+  expect(rules.min_track_width).toBe(0.15)
+  expect(rules.min_copper_edge_clearance).toBe(0.3)
+  expect(pro.board.last_opened_board).toBe("rules.kicad_pcb")
+  expect(pro.net_settings.classes[0].track_width).toBe(0.15)
+})
+
+test("kicad_pro omits min_copper_edge_clearance when not specified", () => {
+  const pro = JSON.parse(
+    createKicadProContent({
+      circuitJson: [
+        {
+          type: "pcb_board",
+          pcb_board_id: "pcb_board_0",
+          center: { x: 0, y: 0 },
+          width: 10,
+          height: 10,
+        } as any,
+      ],
+      projectName: "p",
+      schematicFileName: "p.kicad_sch",
+      boardFileName: "p.kicad_pcb",
+    }),
+  )
+  expect(pro.board.design_settings.rules.min_copper_edge_clearance).toBeUndefined()
+})
